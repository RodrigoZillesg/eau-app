# Simple Dockerfile for direct deployment
# Use this with: docker build -f Dockerfile.simple -t eau-backend:latest .
# Context should be eau-backend directory itself

FROM node:18-alpine

WORKDIR /app

# Copy package files from current directory
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --omit=dev

# Copy pre-built dist folder
COPY dist ./dist

# Create public folder structure
RUN mkdir -p ./public/avatars ./public/events ./public/receipts

# Expose port
EXPOSE 3001

# Start application
CMD ["node", "dist/index.js"]
