# Files to exclude from Docker context
# Since we're using pre-built dist/, we exclude development files

node_modules
npm-debug.log
.git
.gitignore
README.md
.env.local
.vscode
coverage
.nyc_output
.idea
.DS_Store
*.log

# Development files (not needed since we use pre-built dist/)
src
public
.eslintrc.json
tsconfig.json
vite.config.ts
package-lock.json
yarn.lock

# Keep these files:
# - dist/ (our pre-built application)
# - nginx.conf (nginx configuration)
# - .env.production (production env vars)
